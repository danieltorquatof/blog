```{=html}
<%
// Projects grid: Quarto's grid card plus a status badge (searchable through filter-ui).
// The listing-<field> classes are what the listing's sort and filter read.
%>
<div class="list grid quarto-listing-cols-3">
<% for (const item of items) { %>
<div class="g-col-1" <%= metadataAttrs(item) %>>
  <a href="<%- item.path %>" class="quarto-grid-link">
    <div class="quarto-grid-item card h-100 card-left project-card">
      <div class="card-body post-contents">
        <% if (item.status) { %>
        <span class="project-status project-status-<%- item.status %> listing-status"><%= item.status %></span>
        <% } %>

        <h5 class="no-anchor card-title listing-title"><%= item.title %></h5>

        <% if (item.subtitle) { %>
        <div class="card-subtitle listing-subtitle"><%= item.subtitle %></div>
        <% } %>

        <% if (item.categories) { %>
        <div class="listing-categories">
          <% for (const category of item.categories) { %>
          <div class="listing-category" onclick="window.quartoListingCategory('<%= utils.b64encode(category) %>'); return false;"><%= category %></div>
          <% } %>
        </div>
        <% } %>

        <% if (item.description) { %>
        <div class="card-text listing-description delink"><%= item.description %></div>
        <% } %>

        <div class="card-attribution card-text-small justify">
          <% if (item.date) { %>
          <div>Started <span class="listing-date"><%= item.date %></span></div>
          <% } %>
          <% if (item['date-modified']) { %>
          <div>Updated <span class="listing-date-modified"><%= item['date-modified'] %></span></div>
          <% } %>
        </div>
      </div>
    </div>
  </a>
</div>
<% } %>
</div>
```
